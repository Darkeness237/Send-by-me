# Copier en .env.local (jamais commité) et remplir.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (serveur uniquement, ne jamais préfixer par NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=

# Stripe — utiliser une clé restreinte (rk_...) avec Checkout Sessions en écriture
STRIPE_SECRET_KEY=
# Secret du endpoint webhook /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# URL publique du site (sans / final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Relais TURN pour les appels (facultatif, recommandé en production)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# AeroDataBox — vérification des vols dans les horaires réels (facultatif)
# Clé API.Market (en-tête x-api-market-key) ; AEROBOX est aussi accepté comme nom
AERODATABOX_API_KEY=
# Ou, à la place, une clé RapidAPI (abonnement AeroDataBox requis)
AERODATABOX_RAPIDAPI_KEY=
# Sentry — suivi des erreurs (facultatif ; sans DSN, rien n'est envoyé)
# DSN public du projet : Sentry > Project Settings > Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Envoi des sourcemaps au build (Netlify uniquement, jamais exposées au navigateur)
# Jeton : Sentry > Settings > Auth Tokens (portée project:releases et org:read)
SENTRY_AUTH_TOKEN=
# Identifiants (slugs) de l'organisation et du projet Sentry
SENTRY_ORG=
SENTRY_PROJECT=
